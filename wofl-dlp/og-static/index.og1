<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Standard OG/Twitter Tags -->
  <meta property="og:title" content="yt.cafe - Download YouTube Videos Free">
  <meta property="og:description" content="A local web interface for yt-dlp. Simple, fast, and eye-catching.">
  <meta property="og:image" content="https://yt.cafe/static/preview-image.png">
  <meta property="og:url" content="https://yt.cafe">
  <meta property="og:type" content="website">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="yt.cafe - Download YouTube Videos Free">
  <meta name="twitter:description" content="A clean, high-performance UI for yt-dlp. No bloat, just speed.">
  <meta name="twitter:image" content="https://yt.cafe/static/preview-image.png">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>yt.cafe - whispr-dlp</title>
  <link rel="stylesheet" href="/static/styles.css">
  <!-- Adding a clean Sans-Serif font to match the image style -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
</head>
<body>
<div class="shell">
  <header class="hero">
      <div class="eyebrow">LOCAL BROWSER UI FOR YT-DLP</div>
      <h1>YT<span>.CAFE</span></h1>
      <p class="lede">WHISPR-DLP: A LOCAL BROWSER UI FOR YT-DLP</p>
      <div id="system-card" class="status-badge">Checking system…</div>
  </header>

  <main>
    <div class="card highlight">
      <h2>URL TO INSPECT</h2>
      <div class="url-row">
        <input id="url" type="text" placeholder="Paste link here..." value="">
        <button id="probe-btn">DETECT FORMATS</button>
      </div>
    </div>

    <!-- The rest of your functional cards stay here -->
    <div id="probe-card" class="card hidden">
      <h2>DETECTED MEDIA</h2>
      <!-- ... existing content ... -->
    </div>

    <div class="card">
      <div class="grid two">
        <div>
          <label>Mode</label>
          <select id="mode">
            <option value="audio">Audio extract</option>
            <option value="video">Video download/merge</option>
          </select>
        </div>
        <div>
          <label>Output file type</label>
          <select id="container"></select>
        </div>
      </div>

      <label>Source format</label>
      <select id="format"></select>

      <button id="download-btn" class="button primary">START DOWNLOAD</button>
    </div>
    
    <!-- Remaining original cards (Job, Settings, Note) follow the same style -->
<div id="toast" class="toast hidden"></div>
<script src="/static/app.js"></script>
</body>


</html>
  <main>
    <div class="card highlight">
      <h2>URL TO INSPECT</h2>
      <div class="url-row">
        <input id="url" type="text" placeholder="Paste link here..." value="">
        <button id="probe-btn">DETECT FORMATS</button>
      </div>
    </div>
      <div id="probe-card" class="card hidden">
        <h2>DETECTED MEDIA</h2>
          <div class="card">
        <div class="grid two">
          <div>
            <label>Mode</label>
            <select id="mode">
              <option value="audio">Audio extract</option>
              <option value="video">Video download/merge</option>
            </select>
          </div>
          <div>
            <label>Output file type</label>
            <select id="container"></select>
          </div>
        </div>

        <label>Source format</label>
        <select id="format"></select>

        <button id="download-btn" class="button primary">START DOWNLOAD</button>
      </div>
    </div>    
  <div id="toast" class="toast hidden"></div>
  <script src="/static/app.js"></script>
  </body>
    </html>

    <div class="card">
      <h2>URL to inspect</h2>
      <div class="url-row">
        <input id="url" type="text" placeholder="https://www.youtube.com/watch?v=5SZYz7lZRRI or any supported link" value="">
        <button id="probe-btn">Detect formats</button>
      </div>
      <p class="hint">A timestamp like <code>?t=1m23s</code> is detected and can auto-create a five-minute clip.</p>
    </div>

    <div id="probe-card" class="card hidden">
      <h2>detected media</h2>
      <div class="split">
        <div>
          <strong id="media-title"></strong><br>
          <span id="media-meta" class="muted"></span>
        </div>
          <div class="clip-box" id="clip-box">
          <label class="checkbox">
            <input type="checkbox" id="use-clip">
            Clip from detected timestamp
          </label>
            Clip length, seconds
          <input id="clip-length" type="number" value="300" style="width:120px">
          <span id="clip-hint" class="hint"></span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="grid two">
        <div>
          <label>Mode</label>
          <select id="mode">
            <option value="audio">Audio extract</option>
            <option value="video">Video download/merge</option>
          </select>
        </div>
        <div>
          <label>Output file type</label>
          <select id="container"></select>
        </div>
      </div>

      <label>Source format</label>
      <select id="format"></select>
      <p class="hint">Smart best is usually right. Exact source streams are useful when you know precisely what you want.</p>

      <div class="actions">
        <label>Advanced naming</label>
        <input id="title-prefix" type="text" placeholder="Optional filename prefix">
      </div>

      <button id="download-btn" class="button">Start download</button>
    </div>

    <!-- Remaining original cards (Job, Settings, Note) follow the same style -->
      <div id="job-card" class="card hidden">
        <h2>job</h2>
        <div class="split">
          <div>
            <strong id="job-state"></strong><br>
            <span id="job-message"></span>
          </div>
          <a id="save-link" class="button hidden" style="align-self:center">Save file</a>
        </div>
        <progress id="progress" value="0" max="100"></progress>
        <details>
          <summary>Command preview</summary>
          <pre id="command-preview" class="command"></pre>
        </details>
        <details open>
          <summary>Log</summary>
          <pre id="log" class="log"></pre>
        </details>
      </div>

      <div class="card">
        <h2>Settings</h2>
    
        <label>Cookies file path, optional</label>
        <input id="cookies-file" type="text" placeholder="/home/wofl/cookies.txt">
        <p class="hint">Stored locally only. Leave blank unless you need authenticated personal access.</p>

        <label>JavaScript runtime for yt-dlp challenges</label>
        <select id="js-runtime">
          <option value="auto">Auto-detect</option>
          <option value="none">None</option>
          <option value="deno">Deno</option>
          <option value="node">Node</option>
          <option value="bun">Bun</option>
          <option value="qjs">QuickJS</option>
          <option value="qjs-ng">QuickJS-NG</option>
        </select>

        <div class="checkbox">
          <input type="checkbox" id="allow-remote-ejs">
          <label for="allow-remote-ejs">Allow yt-dlp to fetch EJS remote components from GitHub when required</label>
          <span class="hint">Leave this off unless you need it. Remote component fetching intentionally allows yt-dlp to download executable helper scripts.</span>
        </div>

        <div class="checkbox">
          <input type="checkbox" id="public-mode">
          <label for="public-mode">Public mode (Cloudflare Zero Trust / Access)</label>
          <span class="hint">Enable only if this tunnel is protected by Cloudflare Access. Skips localhost origin checks.</span>
        </div>

        <button id="save-settings-btn" class="button">Save settings</button>
      </div>

      <div class="card subtle">
        <h2>Architecture note</h2>
          <p>This is a VPS agent secured by Cloudflare Tunnel + Zero Trust Access. Downloads run on your server. The UI is public but login-protected by Cloudflare. In other words not only have we gone to some efforts to protect our stuff from being banned/blocked/pulled down, we've also gone to efforts to stop your login being caused any problems too!</p>
        </div>
      </div>
    </div>

    <div id="toast" class="toast hidden"></div>

    <script src="/static/app.js"></script>
    </body>
    </html>
  </main>
</div>
