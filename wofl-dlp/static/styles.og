:root {
  --neon-lime: #AAFF00;
  --bg-white: #ffffff;
  --dark-black: #0a0a0a;
  --gray-subtle: #f4f4f4;
}

body {
  margin: 0;
  padding: 0;
  background-color: var(--bg-white);
  color: var(--dark-black);
  font-family: 'Inter', sans-serif;
  line-height: 1.6;
}

.shell {
  max-width: 800px;
  margin: 0 auto;
  padding: 40px 20px;
}

/* Hero Section - Matching the Splash Image */
.hero {
  text-align: center;
  padding: 60px 0;
  border-bottom: 4px solid var(--dark-black);
  margin-bottom: 40px;
}

.hero h1 {
  font-size: 5rem;
  font-weight: 900;
  margin: 0;
  letter-spacing: -2px;
  line-height: 1;
  text-transform: uppercase;
}

.hero h1 span {
  color: var(--neon-lime);
  text-shadow: 2px 2px 0px var(--dark-black);
}

.eyebrow {
  font-weight: 700;
  letter-spacing: 2px;
  font-size: 0.9rem;
  margin-bottom: 10px;
}

.lede {
  font-weight: 700;
  margin-top: 20px;
  background: var(--dark-black);
  color: var(--bg-white);
  display: inline-block;
  padding: 5px 15px;
}

/* Cards & Inputs */
.card {
  background: var(--bg-white);
  border: 3px solid var(--dark-black);
  padding: 30px;
  margin-bottom: 25px;
  box-shadow: 8px 8px 0px var(--neon-lime); /* Pop-art shadow */
}

h2 {
  text-transform: uppercase;
  font-size: 1.2rem;
  margin-top: 0;
  border-bottom: 2px solid var(--neon-lime);
  display: inline-block;
  margin-bottom: 20px;
}

input, select {
  width: 100%;
  padding: 12px;
  border: 2px solid var(--dark-black);
  font-family: inherit;
  font-size: 1rem;
  margin-bottom: 10px;
  box-sizing: border-box;
}

/* Buttons - High Contrast */
.button, button {
  background: var(--dark-black);
  color: var(--neon-lime);
  border: none;
  padding: 15px 25px;
  font-weight: 900;
  text-transform: uppercase;
  cursor: pointer;
  transition: transform 0.1s;
  width: 100%;
}

.button:hover {
  background: var(--neon-lime);
  color: var(--dark-black);
  transform: translate(-2px, -2px);
  box-shadow: 4px 4px 0px var(--dark-black);
}

/* Status Badge */
.status-badge {
  display: inline-block;
  margin-top: 20px;
  padding: 5px 15px;
  border-radius: 20px;
  background: var(--gray-subtle);
  font-size: 0.8rem;
  font-weight: bold;
}

/* Utilities */
.hint { font-size: 0.8rem; color: #666; margin-top: 5px; }
.hidden { display: none; }
